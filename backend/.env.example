# ==================================
# Server Configuration
# ==================================
PORT=5000
NODE_ENV=development

# ==================================
# Frontend URL (for CORS)
# ==================================
FRONTEND_URL=http://localhost:3000

# ==================================
# Database Configuration
# ==================================

# Option 1: Local MongoDB (Development)
# Make sure MongoDB is installed and running locally
# Windows: net start MongoDB
# Mac/Linux: sudo systemctl start mongod
MONGO_URI=mongodb://localhost:27017/hospital_management

# Option 2: MongoDB Atlas (Cloud - Recommended for Production)
# Get your connection string from: https://cloud.mongodb.com
# Replace <username>, <password>, and <cluster-url> with your values
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/hospital_management?retryWrites=true&w=majority

# Option 3: MongoDB Cloud Instance (like Render's MongoDB)
# If you're using a cloud database provider
# MONGO_URI=mongodb+srv://your-cloud-db-url/hospital_management

# ==================================
# Safepay Configuration (Optional)
# ==================================
# Get your keys from: https://dashboard.safepay.com
SAFEPAY_API_KEY=your_safepay_api_key_here
SAFEPAY_SECRET_KEY=your_safepay_secret_key_here
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ==================================
# Application Settings
# ==================================
# Maximum appointment booking window (in months)
MAX_BOOKING_MONTHS=3

# Default appointment fee (in PKR)
DEFAULT_APPOINTMENT_FEE=2000
